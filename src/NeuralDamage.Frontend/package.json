{
  "name": "neural-damage.frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:agent": "ng build --aot --configuration production --output-path",
    "apigen": "bunx @openapitools/openapi-generator-cli generate"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "tailwindFunctions": [
      "hlm",
      "cva",
      "classes"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@microsoft/signalr": "^10.0.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "1.4.1",
    "@types/katex": "^0.16.8",
    "angular-auth-oidc-client": "^21.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^21.0.0",
    "katex": "^0.16.11",
    "luxon": "^3.7.2",
    "marked": "^18.0.13",
    "mermaid": "^11.4.0",
    "ngx-scrollbar": "^19.1.5",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "@spartan-ng/cli": "1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "jsdom": "^27.1.0",
    "ngx-prompt-kit": "^22.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
