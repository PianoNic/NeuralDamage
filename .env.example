# OIDC Provider (Pocket ID, Google, etc.)
Oidc__Authority=https://your-oidc-provider.com
Oidc__ClientId=your-client-id
Oidc__RedirectUri=http://localhost:3000/callback
Oidc__PostLogoutRedirectUri=http://localhost:3000/
Oidc__Scope=openid profile email

# Database - compose.yml sets this for the db service; only needed outside compose
# ConnectionStrings__DefaultConnection=Host=localhost;Database=neuraldamage;Username=neuraldamage;Password=changeme

# OpenRouter (AI models)
OpenRouter__ApiKey=sk-or-v1-your-key-here
# Model policy. Models outside it are hidden from the picker, refused on bot
# create/update, and every generation call sends provider.zdr and
# provider.max_price so OpenRouter only routes to matching endpoints.
# The values below are the defaults; uncomment to change them.
# Price caps, $/million tokens (unset = 0.25 / 0.60, explicit 0 = no limit):
#OpenRouter__MaxPromptPrice=0.25
#OpenRouter__MaxCompletionPrice=0.60
# Only models with a zero-data-retention endpoint:
#OpenRouter__ZdrOnly=true
# Hide :batch variants (async batch jobs, useless in a live chat):
#OpenRouter__ExcludeBatchModels=true
# Turn reasoning off (effort "none"); models that always reason are refused.
# false restores low-effort reasoning and allows those models again.
#OpenRouter__DisableReasoning=true
# Output token budget per bot reply (default 1500; reasoning models need headroom)
# OpenRouter__MaxOutputTokens=1500

# Images. Bots on models that can see get the picture itself; for the others a
# describer model writes a description once per image. It is held to the policy
# above and never a :free variant.
#OpenRouter__VisionModel=google/gemma-3-12b-it
# Where uploads are stored (a volume in compose.yml), the size cap per image in
# bytes, images per message, and how long a reply waits for a description.
#Attachments__Path=data/attachments
#Attachments__MaxBytes=10485760
#Attachments__MaxPerMessage=4
#Attachments__DescriptionWaitSeconds=20

# Per-user rate limits (fixed window); a PermitLimit of 0 turns one off.
#RateLimits__Messages__PermitLimit=20
#RateLimits__Messages__WindowSeconds=60
#RateLimits__Uploads__PermitLimit=20
#RateLimits__Uploads__WindowSeconds=60
#RateLimits__BotCreation__PermitLimit=10
#RateLimits__BotCreation__WindowSeconds=600

# Who replies - Jev on the OpenRouter Decisions API decides, once per message,
# whether each bot replies, reacts with an emoji or stays quiet.
# Only a key is needed; BotRanking__ApiKey falls back to OpenRouter__ApiKey.
# Without a key, or when a call fails or takes longer than the timeout, only
# bots that are @mentioned or replied to answer, and nobody reacts.
#BotRanking__ApiKey=sk-or-v1-your-key-here
#BotRanking__Endpoint=https://openrouter.ai/api/alpha/decisions
#BotRanking__Model=~typesafe/jev-latest
#BotRanking__ReplyThreshold=0.6
#BotRanking__ReactThreshold=0.5
#BotRanking__MaxReplies=5
#BotRanking__Emojis__react_laugh=😂
#BotRanking__Emojis__react_love=❤️
#BotRanking__Emojis__react_wow=😮
#BotRanking__Emojis__react_thumbs=👍
#BotRanking__TimeoutSeconds=5
# The same call scores the conversation's health, 0 (fine) to 2 (bots going
# in circles). From CautiousHealth bots answering a bot need the higher
# threshold and at most CautiousMaxReplies reply; from SilentHealth they only
# react until a person writes again.
#BotRanking__CautiousHealth=0.5
#BotRanking__CautiousReplyThreshold=0.85
#BotRanking__CautiousMaxReplies=1
#BotRanking__SilentHealth=1.0
#BotRanking__HumansActiveMinutes=5
# Safety net: bot messages since a person last wrote before the bots wait.
#Bots__MaxBotMessagesPerPersonMessage=10
